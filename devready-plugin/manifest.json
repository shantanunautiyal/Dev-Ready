{
  "name": "DevReady Inspect",
  "id": "devready-inspect-local",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "dev"
  ],
  "capabilities": [
    "inspect",
    "codegen",
    "vscode"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com",
      "https://api.github.com"
    ],
    "reasoning": "Two independent, user-controlled paths. (1) The HTML preview may load public Google Fonts (e.g. Inter) so text renders in the design's typeface: only public family names and weights are requested and the option can be turned off in Settings. (2) The optional GitHub tab talks to api.github.com and only when you press a button there: it lists your repositories and branches, and when you commit it uploads the generated files you selected plus the commit message. The personal access token you paste is kept on this machine in Figma's plugin storage, is never written into the document, generated code or logs, and can be removed with Disconnect. Nothing is sent automatically and no design data leaves Figma unless you publish it."
  },
  "codegenLanguages": [
    {
      "label": "DevReady \u00b7 React + Tailwind",
      "value": "react-tailwind"
    },
    {
      "label": "DevReady \u00b7 React + CSS",
      "value": "react-css"
    },
    {
      "label": "DevReady \u00b7 React + TypeScript",
      "value": "react-ts"
    },
    {
      "label": "DevReady \u00b7 React + TypeScript + Tailwind",
      "value": "react-tailwind-ts"
    },
    {
      "label": "DevReady \u00b7 HTML + CSS",
      "value": "html-css"
    },
    {
      "label": "DevReady \u00b7 Single HTML (CSS + assets in one file)",
      "value": "html-single"
    },
    {
      "label": "DevReady \u00b7 Vue (single-file component)",
      "value": "vue"
    },
    {
      "label": "DevReady \u00b7 Svelte",
      "value": "svelte"
    },
    {
      "label": "DevReady \u00b7 React Native",
      "value": "react-native"
    },
    {
      "label": "DevReady \u00b7 SwiftUI",
      "value": "swiftui"
    },
    {
      "label": "DevReady \u00b7 Jetpack Compose",
      "value": "compose"
    },
    {
      "label": "DevReady \u00b7 Flutter (Dart)",
      "value": "flutter"
    }
  ],
  "codegenPreferences": [
    {
      "itemType": "unit",
      "scaledUnit": "Rem",
      "defaultScaleFactor": 16,
      "default": false,
      "includedLanguages": [
        "react-tailwind",
        "react-css",
        "react-ts",
        "react-tailwind-ts",
        "html-css",
        "html-single",
        "vue",
        "svelte"
      ]
    },
    {
      "itemType": "select",
      "propertyName": "gate",
      "label": "Dev-ready gate",
      "options": [
        {
          "label": "Only when Ready for dev",
          "value": "strict",
          "isDefault": true
        },
        {
          "label": "Always generate",
          "value": "off"
        }
      ],
      "includedLanguages": [
        "react-tailwind",
        "react-css",
        "react-ts",
        "react-tailwind-ts",
        "html-css",
        "html-single",
        "vue",
        "svelte",
        "react-native",
        "swiftui",
        "compose",
        "flutter"
      ]
    }
  ],
  "relaunchButtons": [
    {
      "command": "open",
      "name": "Inspect with DevReady",
      "multipleSelection": true
    }
  ]
}
