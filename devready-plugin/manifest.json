{
  "name": "DevReady Inspect",
  "id": "devready-inspect-local",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "dev"
  ],
  "capabilities": [
    "inspect",
    "codegen",
    "vscode"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com"
    ],
    "reasoning": "The HTML preview can load public Google Fonts (e.g. Inter) so text renders in the design's typeface. Only public Google Fonts family names and weights are requested; private, commercial and system font names are never sent, and no design data, text or file information leaves Figma. The plugin's main code makes no network requests. Turn this off with ⋯ → Load Google Fonts in preview."
  },
  "codegenLanguages": [
    {
      "label": "DevReady · React + Tailwind",
      "value": "react-tailwind"
    },
    {
      "label": "DevReady · React + CSS",
      "value": "react-css"
    },
    {
      "label": "DevReady · React + TypeScript",
      "value": "react-ts"
    },
    {
      "label": "DevReady · React + TypeScript + Tailwind",
      "value": "react-tailwind-ts"
    },
    {
      "label": "DevReady · HTML + CSS",
      "value": "html-css"
    },
    {
      "label": "DevReady · Single HTML (CSS + assets in one file)",
      "value": "html-single"
    },
    {
      "label": "DevReady · Vue (single-file component)",
      "value": "vue"
    },
    {
      "label": "DevReady · Svelte",
      "value": "svelte"
    },
    {
      "label": "DevReady · React Native",
      "value": "react-native"
    },
    {
      "label": "DevReady · SwiftUI",
      "value": "swiftui"
    },
    {
      "label": "DevReady · Jetpack Compose",
      "value": "compose"
    },
    {
      "label": "DevReady · Flutter (Dart)",
      "value": "flutter"
    }
  ],
  "codegenPreferences": [
    {
      "itemType": "unit",
      "scaledUnit": "Rem",
      "defaultScaleFactor": 16,
      "default": false,
      "includedLanguages": [
        "react-tailwind",
        "react-css",
        "react-ts",
        "react-tailwind-ts",
        "html-css",
        "html-single",
        "vue",
        "svelte"
      ]
    },
    {
      "itemType": "select",
      "propertyName": "gate",
      "label": "Dev-ready gate",
      "options": [
        {
          "label": "Only when Ready for dev",
          "value": "strict",
          "isDefault": true
        },
        {
          "label": "Always generate",
          "value": "off"
        }
      ],
      "includedLanguages": [
        "react-tailwind",
        "react-css",
        "react-ts",
        "react-tailwind-ts",
        "html-css",
        "html-single",
        "vue",
        "svelte",
        "react-native",
        "swiftui",
        "compose",
        "flutter"
      ]
    }
  ],
  "relaunchButtons": [
    {
      "command": "open",
      "name": "Inspect with DevReady",
      "multipleSelection": true
    }
  ]
}
